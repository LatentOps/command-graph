{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "ordin-claude-hook post",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "command": "ordin-claude-hook post-failure",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "ordin-claude-hook pre",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  }
}
